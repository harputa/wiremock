{
  "name": "header-driven-wiremock-service-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright API tests for the WireMock mock endpoints and the Spring Boot admin endpoints, driven by ../mock-data",
  "scripts": {
    "test": "playwright test",
    "test:wiremock": "playwright test --project=wiremock",
    "test:admin": "playwright test --project=admin",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
